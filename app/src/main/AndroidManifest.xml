<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only used when the leaderboard is switched on. With it off the app
         never opens a connection. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reads which app is foreground, so the counter comes down and the
         service switches itself off once the user leaves Instagram. A special
         access the user grants by hand; it carries no screen content and does
         not trip a payment app's checks. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- The floating counter over Instagram. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Lets the app ask for a battery-optimisation exemption; without it the
         OEM background killer stops counting silently. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The in-app updater installs a newer APK it downloaded from the app's own
         GitHub releases. The system still shows its Install confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility (Android 11+). Without these two declarations the
         system hides Instagram and YouTube from this app entirely: "is it
         installed?" answers no, launch intents come back null. That is what
         kept Shorts off in build 50: YouTube looked uninstalled, so the
         one-time "count Shorts?" card never appeared, setup never ticked it,
         and the service was never told to listen to YouTube. Only these two
         apps are asked about; no QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
        android:name=".EkAurApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.EkAur">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EkAur">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands a rendered card to whichever app the user picks. Not
             exported: access is granted per share, per file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.cards"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_cards" />
        </provider>

        <service
            android:name=".service.EkAurAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- A shade tile to switch counting off for a payment and back on. A
             payment app can block while any accessibility service is enabled;
             this is the one-tap way to pause without digging through settings. -->
        <service
            android:name=".service.PauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_tally"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Receives the in-app updater's install-session status, and launches the
             system confirm dialog when the session asks for user action. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Shares diagnostic dumps out through the share sheet; with no USB on
             the test device this is the only way to get text off the phone. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
