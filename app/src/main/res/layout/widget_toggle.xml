<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen toggle. A pill: the tally mark, the wordmark, and the state.
  Everything that changes with on/off (the background, the text, the icon tint,
  the words) is set from EkAurWidgetProvider, so this file only lays it out.
  Drawn as RemoteViews, so plain views only, no Compose.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_bg_off">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_tile_tally"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EK AUR"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.22"
            android:textColor="#8A8A8A" />

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:letterSpacing="0.02"
            android:textColor="#F2F2F2" />
    </LinearLayout>
</LinearLayout>
