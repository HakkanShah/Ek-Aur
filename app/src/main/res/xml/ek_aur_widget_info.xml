<?xml version="1.0" encoding="utf-8"?>
<!--
  A 2x1 chip. updatePeriodMillis is 0 because the state only changes when the
  service turns on or off, and those moments push an update themselves rather
  than waiting for a poll (the shortest poll Android allows is 30 minutes).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_toggle"
    android:previewLayout="@layout/widget_toggle"
    android:description="@string/widget_desc" />
