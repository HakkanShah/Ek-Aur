<?xml version="1.0" encoding="utf-8"?>
<!--
  packageNames is restricted to Instagram. This is the whole privilege the
  service holds: it can receive events from, and read the screen of, exactly
  one app, and is blind to every other app on the phone.

  It matters most for payment apps. UPI and banking apps are required to warn
  about accessibility services, because reading another app's screen is how
  credential-stealing malware works. A service scoped to one app cannot see a
  banking app at all — no events, no window content — so a check that reads
  this scope has nothing to flag, and a payment screen is never delivered here
  even by accident.

  It costs one thing: the service no longer sees the foreground move to another
  app, so a sitting is closed by the idle timer rather than the instant the
  user leaves Instagram. That is a few seconds of a stale session, never a
  wrong count.

  typeWindowContentChanged is deliberately NOT subscribed to. A device dump
  measured it at 84% of all traffic (336 of 400 events), which flooded the
  inspector's buffer and evicted the actual scrolling we were trying to observe.
  It contributes nothing now that the state machine is driven purely by scroll
  events, and dropping it is a significant battery saving.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:packageNames="com.instagram.android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="0" />
